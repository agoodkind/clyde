[logging]
level = "debug"

[conversation.semantic]
{{if .IngestionEnabled}}ingestion_enabled = true
{{end}}{{if .SearchEnabled}}search_enabled = true
{{end}}{{if or .IngestionEnabled .SearchEnabled}}milvus_address = "[::1]:1"
{{end}}collection_id = {{printf "%q" .CollectionID}}
{{- if .IndexedContent}}
indexed_content = [{{range $i, $kind := .IndexedContent}}{{if $i}}, {{end}}{{printf "%q" $kind}}{{end}}]
{{- end}}

[adapter]
enabled = false

[mitm]
enabled_default = false
